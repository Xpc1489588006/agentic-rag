APP_NAME=agentic-rag
LPG_LEVEL=INFO

# ===== PostgreSQL（docker-compose 与后端共用）=====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_kb
POSTGRES_PORT=5432

# 后端连接串：注意使用 asyncpg driver
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_kb

# ===== 应用配置 =====
LOG_LEVEL=INFO
# 逗号分隔，前端开发地址
CORS_ORIGINS=http://localhost:5173

# ===== 腾讯云 COS =====
# 开发期可暂时留空，/api/health/cos 会返回未配置状态
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-beijing
COS_BUCKET=

# ===== Embedding（DashScope OpenAI 兼容协议）=====
# 百炼控制台创建 API Key；模型名必须为合法 ID（如 text-embedding-v4），
# 维度需与 alembic 迁移中 Vector(N) 保持一致
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# ===== 文档上传与切分 =====
UPLOAD_MAX_SIZE_MB=50
CHUNK_SIZE=600
CHUNK_OVERLAP=60
